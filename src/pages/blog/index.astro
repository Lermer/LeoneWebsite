---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const blogPosts = await getCollection('blog', ({ data }) => {
  return data.draft !== true;
});

// Sort posts by date (newest first)
blogPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Blog - Leone Ermer">
  <h1>Blog</h1>

  <div class="posts">
    {blogPosts.map((post) => (
      <article>
        <h2>
          <a href={`/blog/${post.slug}`}>{post.data.title}</a>
        </h2>
        <p class="date">{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
        <p>{post.data.description}</p>
        {post.data.tags && (
          <div class="tags">
            {post.data.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )}
      </article>
    ))}
  </div>
</BaseLayout>

<style>
  h1 {
    margin-bottom: 2rem;
  }

  .posts {
    display: grid;
    gap: 2rem;
  }

  article {
    padding: 1.5rem 0;
    border-bottom: 1px solid #000;
  }

  h2 {
    margin: 0 0 0.5rem 0;
    font-size: 18px;
    font-weight: 500;
  }

  h2 a {
    transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  h2 a:hover {
    opacity: 0.6;
  }

  .date {
    color: #999;
    margin: 0 0 1rem 0;
  }

  .tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }

  .tag {
    background: #efefef;
    padding: 0.2rem 0.6rem;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #666;
  }
</style>
