---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Leone Ermer Website' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto+Mono:wght@300;400;500;600;700&family=Roboto+Serif:opsz,wdth,wght,GRAD@8..144,50..100,100..900,-50..100&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <nav>
        <a href="/" class="logo">LEONE ERMER</a>
        <a href="#" class="menu">MENU<span class="arrow">↗</span></a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>&copy; {new Date().getFullYear()} Leone Ermer</p>
    </footer>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    padding: 0;
    font-family: 'Roboto Mono', monospace;
    font-size: 14px;
  }

  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    padding: 30px 40px;
    z-index: 10;
    background: transparent;
  }

  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 10px;
    border-bottom: 1px solid #000;
  }

  nav a {
    font-family: 'Roboto Mono', monospace;
    font-size: 15px;
    line-height: 28px;
    letter-spacing: -0.5625px;
    text-decoration: none;
    color: #000;
  }

  nav a:hover {
    opacity: 0.7;
  }

  .logo {
    font-weight: 400;
  }

  .menu {
    display: flex;
    align-items: center;
    gap: 1px;
  }

  .arrow {
    font-size: 22px;
    line-height: 1;
  }

  main {
    margin: 0;
    padding: 0;
    min-height: calc(100vh - 200px);
  }

  footer {
    padding: 30px 40px;
    text-align: center;
    border-top: 1px solid #000;
    font-family: 'Roboto Mono', monospace;
    font-size: 14px;
    color: #000;
  }

  footer p {
    margin: 0;
  }
</style>
