---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Leone Ermer - About" pageName="About">
  <section class="about">
    <div class="about-grid">
      <div class="about-text">
        <p>
          Hi, I'm Leone — I'm an art director and designer in Los&nbsp;Angeles. I've branded companies, launched products, and designed experiences.
        </p>
        <p>
          I'm always looking forward — pulling from art history, technology, and the mechanics of play to figure out what comes next.
        </p>
        <p class="aspirations-intro">Here's a list of some things I would love to design.</p>
        <ol>
          <li>An underwater exhibit</li>
          <li>A story driven scavenger hunt</li>
          <li>Hands Across America 2.0</li>
          <li>A wine label</li>
          <li>Something that goes to space?</li>
        </ol>
        <p class="cta-text">Want to make one of these with me? Or have something else in mind?</p>
        <p><a href="/contact" class="lets-talk">Let's talk.</a></p>
      </div>
      <div class="about-image">
        <img src="/images/Leone.png" alt="Leone Ermer" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    min-height: 100vh;
    background: #FFFFFF;
  }

  .about-grid {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    column-gap: 20px;
    padding: 160px 40px 40px 40px;
    min-height: calc(100vh - 100px);
  }

  .about-text {
    grid-column: 3 / 6;
    align-self: start;
    padding-top: 40px;
  }

  .about-text p {
    margin: 0 0 24px 0;
  }

  .about-text ol {
    margin: 0 0 32px 0;
    padding-left: 24px;
  }

  .about-text ol li {
    margin-bottom: 4px;
  }

  .lets-talk {
    transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: opacity;
  }

  .lets-talk:hover {
    opacity: 0.6;
  }

  .about-image {
    grid-column: 7 / 9;
    align-self: end;
  }

  .about-image img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  @media (max-width: 900px) {
    .about-grid {
      padding: 140px 40px 40px 40px;
    }

    .about-text {
      grid-column: 2 / 6;
      padding-top: 20px;
    }

    .about-image {
      grid-column: 6 / 9;
    }
  }

  @media (max-width: 640px) {
    .about-grid {
      padding: 120px 20px 20px 20px;
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .about-text {
      grid-column: 1;
      padding-top: 0;
    }

    .about-image {
      grid-column: 1;
      align-self: start;
    }

  }
</style>
