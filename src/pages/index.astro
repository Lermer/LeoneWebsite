---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Leone Ermer - Home">
  <div class="hero">
    <h1>Leone Ermer is a Los Angeles–based creative whose work spans branding, experiential design, and art.</h1>
  </div>
</BaseLayout>

<style>
  :global(body) {
    overflow: hidden;
  }

  :global(footer) {
    display: none;
  }

  .hero {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: linear-gradient(0deg, #FFFFFF 0%, #0048FF 100%);
    overflow: hidden;
  }

  h1 {
    position: fixed;
    left: 36.4px;
    bottom: 100px;
    width: 1080px;
    max-width: calc(100% - 80px);
    font-family: 'Roboto Serif', serif;
    font-style: normal;
    font-weight: 368;
    font-size: 78px;
    line-height: 120%;
    color: #000000;
    margin: 0;
    font-variation-settings: 'wdth' 50, 'GRAD' 0;
    transform: rotate(-0.48deg);
  }

  @media (max-width: 900px) {
    h1 {
      font-size: 59px;
      left: 30px;
      max-width: calc(100% - 60px);
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding: 30px 20px 80px 20px;
    }

    h1 {
      font-size: 44px;
      left: 20px;
      bottom: 80px;
      max-width: calc(100% - 40px);
    }
  }
</style>
