---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Leone Ermer Website' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto+Mono:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://use.typekit.net/vcu6pxy.css" />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <nav>
        <a href="/" class="logo">LEONE ERMER</a>
        <a href="#" class="menu" id="menuToggle">MENU<span class="arrow">↗</span></a>
      </nav>
    </header>

    <!-- Menu Overlay -->
    <div class="menu-overlay" id="menuOverlay">
      <div class="menu-header">
        <nav class="menu-nav">
          <a href="/" class="menu-logo">LEONE ERMER</a>
          <a href="#" class="menu-close" id="menuClose">MENU<span class="arrow">↗</span></a>
        </nav>
      </div>

      <div class="menu-items">
        <div class="menu-item">
          <a href="/about">About</a>
          <div class="menu-item-divider"></div>
        </div>
        <div class="menu-item">
          <a href="/work">Work</a>
          <div class="menu-item-divider"></div>
        </div>
        <div class="menu-item">
          <a href="/cv">CV</a>
          <div class="menu-item-divider"></div>
        </div>
      </div>

      <div class="menu-footer">
        <a href="/contact" class="footer-link">CONTACT</a>
        <a href="/index" class="footer-link">INDEX</a>
        <span class="footer-copyright">&copy;{new Date().getFullYear()} LEONE ERMER</span>
      </div>
    </div>

    <main>
      <slot />
    </main>
    <footer>
      <p>&copy; {new Date().getFullYear()} Leone Ermer</p>
    </footer>

    <script>
      const menuToggle = document.getElementById('menuToggle');
      const menuClose = document.getElementById('menuClose');
      const menuOverlay = document.getElementById('menuOverlay');
      const header = document.querySelector('header');

      function toggleMenu() {
        const isActive = menuOverlay?.classList.contains('active');
        if (isActive) {
          menuOverlay?.classList.remove('active');
          header?.classList.remove('menu-active');
        } else {
          menuOverlay?.classList.add('active');
          header?.classList.add('menu-active');
        }
      }

      menuToggle?.addEventListener('click', (e) => {
        e.preventDefault();
        toggleMenu();
      });

      menuClose?.addEventListener('click', (e) => {
        e.preventDefault();
        toggleMenu();
      });
    </script>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    padding: 0;
    font-family: 'Roboto Mono', monospace;
    font-size: 14px;
  }

  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    padding: 30px 40px;
    z-index: 10000;
    background: transparent;
  }

  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 10px;
    border-bottom: 1px solid #000;
    transition: border-color 0.3s ease;
  }

  nav a {
    font-family: 'Roboto Mono', monospace;
    font-size: 14px;
    line-height: 28px;
    letter-spacing: -0.5625px;
    text-decoration: none;
    color: #000;
    transition: color 0.3s ease, opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: opacity;
  }

  /* Header styling when menu is active */
  header.menu-active nav {
    border-bottom-color: #FFFFFF;
  }

  header.menu-active nav a {
    color: #FFFFFF;
  }

  nav a:hover {
    opacity: 0.6;
  }

  .logo {
    font-weight: 400;
  }

  .menu {
    display: flex;
    align-items: center;
    gap: 1px;
  }

  .arrow {
    font-size: 22px;
    line-height: 1;
  }

  main {
    margin: 0;
    padding: 0;
    min-height: calc(100vh - 200px);
  }

  footer {
    padding: 30px 40px;
    text-align: center;
    border-top: 1px solid #000;
    font-family: 'Roboto Mono', monospace;
    font-size: 14px;
    color: #000;
  }

  footer p {
    margin: 0;
    transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: opacity;
  }

  footer:hover p {
    opacity: 0.7;
  }

  /* Menu Overlay */
  .menu-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: #000000;
    z-index: 1000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .menu-overlay.active {
    opacity: 1;
    pointer-events: all;
  }

  /* Menu Header */
  .menu-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 30px 40px;
    gap: 10px;
  }

  .menu-nav {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 10px;
    border-bottom: 1px solid #FFFFFF;
  }

  .menu-logo,
  .menu-close {
    font-family: 'Roboto Mono', monospace;
    font-size: 14px;
    line-height: 28px;
    letter-spacing: -0.5625px;
    text-decoration: none;
    color: #FFFFFF;
  }

  .menu-close {
    display: flex;
    align-items: center;
    gap: 1px;
    transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: opacity;
  }

  .menu-close:hover {
    opacity: 0.6;
  }

  /* Menu Items */
  .menu-items {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    padding-right: 40px;
    margin-top: auto;
    margin-bottom: auto;
    gap: 20px;
  }

  .menu-item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 40px;
    gap: 10px;
    min-width: 60%;
  }

  .menu-item a {
    font-family: 'new-spirit', serif;
    font-style: normal;
    font-weight: 700;
    font-size: 64px;
    line-height: 64px;
    display: flex;
    align-items: flex-end;
    letter-spacing: -0.5625px;
    color: #FFFFFF;
    text-decoration: none;
    transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: opacity;
  }

  .menu-item a:hover {
    opacity: 0.6;
  }

  .menu-item-divider {
    width: 100%;
    height: 1px;
    background: #FFFFFF;
  }

  /* Menu Footer */
  .menu-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 40px;
    width: 100%;
    box-sizing: border-box;
  }

  .footer-link,
  .footer-copyright {
    font-family: 'Roboto Mono', monospace;
    font-size: 13px;
    line-height: 28px;
    letter-spacing: -0.5625px;
    color: #FFFFFF;
    text-decoration: none;
  }

  .footer-link {
    transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: opacity;
  }

  .footer-link:hover {
    opacity: 0.6;
  }

  /* Responsive styles for menu */
  @media (max-width: 900px) {
    .menu-item a {
      font-size: 48px;
      line-height: 48px;
    }

    .menu-item {
      min-width: 70%;
      padding: 30px;
    }
  }

  @media (max-width: 640px) {
    .menu-header {
      padding: 20px;
    }

    .menu-items {
      padding-right: 20px;
      gap: 10px;
    }

    .menu-item {
      min-width: 80%;
      padding: 20px;
    }

    .menu-item a {
      font-size: 36px;
      line-height: 36px;
    }

    .menu-footer {
      padding: 20px;
      flex-direction: column;
      gap: 10px;
      align-items: flex-start;
    }
  }
</style>
