---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Leone Ermer - Home">
  <div class="hero">
    <h1>
      <span class="trigger" data-image="https://picsum.photos/400/500?random=1">Leone Ermer</span><wbr> is a Los&nbsp;Angeles–based<wbr> creative whose work spans <span class="trigger" data-image="https://picsum.photos/400/500?random=3">experiential design</span>,<wbr> <span class="trigger" data-image="https://picsum.photos/400/500?random=2">branding</span>,<wbr> and&nbsp;<span class="trigger" data-image="https://picsum.photos/400/500?random=4">art</span>.
    </h1>
    <div class="hover-image" id="hoverImage">
      <img src="" alt="">
    </div>
  </div>
</BaseLayout>

<style>
  :global(body) {
    overflow: hidden;
  }

  :global(footer) {
    display: none;
  }

  .hero {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: linear-gradient(0deg, #FFFFFF 22.12%, #7EC3FF 56.25%, #0048FF 100%);
    overflow: hidden;
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    column-gap: 20px;
    padding: 0 40px;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: #0048FF;
    animation: sunrise 2.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    pointer-events: none;
  }

  @keyframes sunrise {
    from {
      opacity: 1;
      transform: translateY(0);
    }
    to {
      opacity: 0;
      transform: translateY(-20%);
    }
  }

  h1 {
    position: fixed;
    left: 40px;
    bottom: 20px;
    grid-column: 1 / 7;
    width: calc((100vw - 80px - 140px) * 6 / 8 + 100px);
    font-family: 'new-spirit-condensed', serif;
    font-style: normal;
    font-weight: 700;
    font-size: 78px;
    line-height: 120%;
    color: #000000;
    margin: 0;
    transform: rotate(-0.48deg);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  h1.ready {
    opacity: 1;
  }

  .trigger {
    position: relative;
    cursor: pointer;
    transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: opacity;
  }

  @media screen and (min-width: 900px) {
    .trigger:hover {
      opacity: 0.3;
    }
  }

  .hover-image {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
    opacity: 0;
    transform-origin: center center;
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 9999;
    will-change: transform, opacity;
    --extraOffset: -1.125;
  }

  .hover-image.active {
    opacity: 1;
  }

  .hover-image img {
    width: 400px;
    height: 500px;
    object-fit: cover;
    border-radius: 6px;
    box-shadow:
      0 2px 8px rgba(0, 0, 0, 0.06),
      0 8px 24px rgba(0, 0, 0, 0.12),
      0 16px 48px rgba(0, 0, 0, 0.16);
    transform-origin: center center;
    opacity: 0;
    transform: scale(0.5);
    transition:
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hover-image.active img {
    opacity: 1;
    transform: scale(1);
  }

  @media (max-width: 900px) {
    .hero {
      padding: 0 30px;
      column-gap: 15px;
    }

    h1 {
      font-size: 59px;
      left: 30px;
      width: calc((100vw - 60px - 105px) * 6 / 8 + 75px);
      grid-column: 1 / 7;
    }

    .hover-image img {
      width: 300px;
      height: 375px;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding: 30px 20px 80px 20px;
      column-gap: 10px;
    }

    h1 {
      font-size: 44px;
      left: 20px;
      bottom: 20px;
      width: calc(100vw - 40px);
      grid-column: 1 / 9;
    }

    .hover-image img {
      width: 250px;
      height: 312px;
    }
  }
</style>

<script>
  const triggers = document.querySelectorAll('.trigger');
  const hoverImage = document.getElementById('hoverImage') as HTMLElement;
  const img = hoverImage?.querySelector('img') as HTMLImageElement;
  const h1 = document.querySelector('h1') as HTMLElement;

  // Wait for fonts to load before showing text (prevents width flicker)
  document.fonts.ready.then(() => {
    h1?.classList.add('ready');
  });

  // Simple delay/lag with linear interpolation (no bounce)
  let targetX = 0;
  let targetY = 0;
  let currentX = 0;
  let currentY = 0;
  let targetRotation = 0;
  let currentRotation = 0;

  const lerp = 0.06; // Interpolation factor (lower = more delay)
  const rotationLerp = 0.08; // Slightly faster for rotation

  // Track mouse position and calculate subtle rotation
  let lastMouseX = 0;
  document.addEventListener('mousemove', (e) => {
    const deltaX = e.clientX - lastMouseX;
    targetX = e.clientX;
    targetY = e.clientY;
    // Subtle rotation based on horizontal movement (-3 to 3 degrees)
    targetRotation = Math.max(-3, Math.min(3, deltaX * 0.15));
    lastMouseX = e.clientX;
  });

  // Simple lerp animation loop (no bounce, just smooth delay)
  function animate() {
    if (hoverImage?.classList.contains('active')) {
      // Smoothly interpolate toward target (no bounce)
      currentX += (targetX - currentX) * lerp;
      currentY += (targetY - currentY) * lerp;
      currentRotation += (targetRotation - currentRotation) * rotationLerp;

      // Get image dimensions
      const rect = img.getBoundingClientRect();

      // Position from bottom-left corner using transform (hardware accelerated)
      const x = currentX;
      const y = currentY - rect.height;
      hoverImage.style.transform = `translate3d(${x}px, ${y}px, 0) rotate(${currentRotation}deg)`;
    } else {
      // Reset rotation when not active
      currentRotation += (0 - currentRotation) * rotationLerp;
    }
    requestAnimationFrame(animate);
  }
  animate();

  triggers.forEach(trigger => {
    trigger.addEventListener('mouseenter', (e) => {
      const target = e.target as HTMLElement;
      const imageSrc = target.dataset.image;

      if (imageSrc && img) {
        img.src = imageSrc;

        // Initialize position to avoid jump
        const mouseEvent = e as MouseEvent;
        const rect = img.getBoundingClientRect();
        currentX = mouseEvent.clientX;
        currentY = mouseEvent.clientY;

        const x = currentX;
        const y = currentY - rect.height;
        hoverImage.style.transform = `translate3d(${x}px, ${y}px, 0)`;

        hoverImage?.classList.add('active');
      }
    });

    trigger.addEventListener('mouseleave', () => {
      hoverImage?.classList.remove('active');
    });
  });
</script>
