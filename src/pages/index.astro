---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Leone Ermer - Home">
  <div class="hero">
    <h1>
      <span class="trigger" data-image="https://picsum.photos/400/500?random=1">Leone Ermer</span> is a Los Angeles–based creative whose work spans <span class="trigger" data-image="https://picsum.photos/400/500?random=2">branding</span>, <span class="trigger" data-image="https://picsum.photos/400/500?random=3">experiential design</span>, and <span class="trigger" data-image="https://picsum.photos/400/500?random=4">art</span>.
    </h1>
    <div class="hover-image" id="hoverImage">
      <img src="" alt="">
    </div>
  </div>
</BaseLayout>

<style>
  :global(body) {
    overflow: hidden;
  }

  :global(footer) {
    display: none;
  }

  .hero {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: linear-gradient(0deg, #FFFFFF 0%, #0048FF 100%);
    overflow: hidden;
  }

  h1 {
    position: fixed;
    left: 36.4px;
    bottom: 100px;
    width: 1080px;
    max-width: calc(100% - 80px);
    font-family: 'Roboto Serif', serif;
    font-style: normal;
    font-weight: 368;
    font-size: 78px;
    line-height: 120%;
    color: #000000;
    margin: 0;
    font-variation-settings: 'wdth' 50, 'GRAD' 0;
    transform: rotate(-0.48deg);
  }

  .trigger {
    position: relative;
    cursor: pointer;
    transition: 0.2s opacity;
  }

  @media screen and (min-width: 900px) {
    .trigger:hover {
      opacity: 0.2;
    }
  }

  .hover-image {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 9999;
    will-change: transform, opacity;
    --extraOffset: -1.125;
  }

  .hover-image.active {
    opacity: 1;
  }

  .hover-image img {
    width: 400px;
    height: 500px;
    object-fit: cover;
    border-radius: 4px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
  }

  @media (max-width: 900px) {
    h1 {
      font-size: 59px;
      left: 30px;
      max-width: calc(100% - 60px);
    }

    .hover-image img {
      width: 300px;
      height: 375px;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding: 30px 20px 80px 20px;
    }

    h1 {
      font-size: 44px;
      left: 20px;
      bottom: 80px;
      max-width: calc(100% - 40px);
    }

    .hover-image img {
      width: 250px;
      height: 312px;
    }
  }
</style>

<script>
  const triggers = document.querySelectorAll('.trigger');
  const hoverImage = document.getElementById('hoverImage') as HTMLElement;
  const img = hoverImage?.querySelector('img') as HTMLImageElement;

  // Simple delay/lag with linear interpolation (no bounce)
  let targetX = 0;
  let targetY = 0;
  let currentX = 0;
  let currentY = 0;

  const lerp = 0.06; // Interpolation factor (lower = more delay)

  // Track mouse position
  document.addEventListener('mousemove', (e) => {
    targetX = e.clientX;
    targetY = e.clientY;
  });

  // Simple lerp animation loop (no bounce, just smooth delay)
  function animate() {
    if (hoverImage?.classList.contains('active')) {
      // Smoothly interpolate toward target (no bounce)
      currentX += (targetX - currentX) * lerp;
      currentY += (targetY - currentY) * lerp;

      // Get image dimensions
      const rect = img.getBoundingClientRect();

      // Position from bottom-left corner using transform (hardware accelerated)
      const x = currentX;
      const y = currentY - rect.height;
      hoverImage.style.transform = `translate3d(${x}px, ${y}px, 0)`;
    }
    requestAnimationFrame(animate);
  }
  animate();

  triggers.forEach(trigger => {
    trigger.addEventListener('mouseenter', (e) => {
      const target = e.target as HTMLElement;
      const imageSrc = target.dataset.image;

      if (imageSrc && img) {
        img.src = imageSrc;

        // Initialize position to avoid jump
        const mouseEvent = e as MouseEvent;
        const rect = img.getBoundingClientRect();
        currentX = mouseEvent.clientX;
        currentY = mouseEvent.clientY;

        const x = currentX;
        const y = currentY - rect.height;
        hoverImage.style.transform = `translate3d(${x}px, ${y}px, 0)`;

        hoverImage?.classList.add('active');
      }
    });

    trigger.addEventListener('mouseleave', () => {
      hoverImage?.classList.remove('active');
    });
  });
</script>
