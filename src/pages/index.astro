---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Leone Ermer - Home">
  <div class="hero">
    <h1>Leone Ermer is a Los Angeles–based creative whose work spans branding, experiential design, and art.</h1>
  </div>
</BaseLayout>

<style>
  .hero {
    position: relative;
    width: 100%;
    min-height: calc(100vh - 200px);
    background: linear-gradient(0deg, #FFFFFF 0%, #0048FF 100%);
    display: flex;
    align-items: flex-end;
    padding: 40px;
  }

  h1 {
    font-family: 'Roboto Serif', serif;
    font-style: normal;
    font-weight: 368;
    font-size: 78px;
    line-height: 120%;
    color: #000000;
    margin: 0;
    max-width: 1080px;
    font-variation-settings: 'GRAD' 0;
  }

  @media (max-width: 900px) {
    h1 {
      font-size: 59px;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding: 30px 20px;
    }

    h1 {
      font-size: 44px;
    }
  }
</style>
